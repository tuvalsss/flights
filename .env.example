# ──────────────────────────────────────────────────────────────
# FlightsBook — Environment configuration
# Copy this file to ".env.local" and fill in your real values.
# ──────────────────────────────────────────────────────────────

# Public site URL (used for Stripe redirects & metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Payments (Stripe) ─────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
# If STRIPE_SECRET_KEY is left empty, the site runs in DEMO mode:
# orders are recorded but no real charge is made.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=

# Currency for checkout (ISO 4217), e.g. usd, eur
PAYMENT_CURRENCY=usd

# ── Admin panel ───────────────────────────────────────────────
# Username + password to access /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
# Random long string used to sign admin session cookies
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
